{
  "info": {
    "name": "Form Management API",
    "_postman_id": "bfb0d2a0-0000-4000-8000-000000000000",
    "description": "Postman collection for the Form Management API (local: http://localhost:8080)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Forms (paged)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/api/forms?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api","forms"], "query": [{"key":"page","value":"0"},{"key":"size","value":"10"}] }
      }
    },
    {
      "name": "Get Active Forms",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/forms/active", "host": ["{{baseUrl}}"], "path": ["api","forms","active"] }
      }
    },
    {
      "name": "Create Form",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sample Form\",\n  \"description\": \"Example form created from Postman\",\n  \"status\": \"ACTIVE\",\n  \"fields\": [\n    { \"label\": \"Full Name\", \"type\": \"TEXT\", \"required\": true },\n    { \"label\": \"Age\", \"type\": \"NUMBER\", \"required\": false },\n    { \"label\": \"Favorite Color\", \"type\": \"COLOR\", \"required\": false }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/forms", "host": ["{{baseUrl}}"], "path": ["api","forms"] }
      }
    },
    {
      "name": "Get Form by ID",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/forms/:id", "host": ["{{baseUrl}}"], "path": ["api","forms",":id"], "variable": [{"key":"id","value":"1"}] }
      }
    },
    {
      "name": "Update Form",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Form Name\",\n  \"description\": \"Updated description\",\n  \"status\": \"ACTIVE\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/forms/:id", "host": ["{{baseUrl}}"], "path": ["api","forms",":id"], "variable": [{"key":"id","value":"1"}] }
      }
    },
    {
      "name": "Delete Form",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/forms/:id", "host": ["{{baseUrl}}"], "path": ["api","forms",":id"], "variable": [{"key":"id","value":"1"}] }
      }
    },
    {
      "name": "Add Field to Form",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"label\": \"Country\",\n  \"type\": \"SELECT\",\n  \"required\": false,\n  \"optionsJson\": \"[\\\"US\\\", \\\"CA\\\", \\\"VN\\\"]\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/forms/:formId/fields", "host": ["{{baseUrl}}"], "path": ["api","forms",":formId","fields"], "variable": [{"key":"formId","value":"1"}] }
      }
    },
    {
      "name": "Update Field",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"label\": \"Country of Residence\",\n  \"required\": true\n}" },
        "url": { "raw": "{{baseUrl}}/api/forms/:formId/fields/:fieldId", "host": ["{{baseUrl}}"], "path": ["api","forms",":formId","fields",":fieldId"], "variable": [{"key":"formId","value":"1"},{"key":"fieldId","value":"2"}] }
      }
    },
    {
      "name": "Delete Field",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/forms/:formId/fields/:fieldId", "host": ["{{baseUrl}}"], "path": ["api","forms",":formId","fields",":fieldId"], "variable": [{"key":"formId","value":"1"},{"key":"fieldId","value":"2"}] }
      }
    },
    {
      "name": "Submit Form",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"values\": [\n    { \"fieldId\": 1, \"value\": \"Nguyễn Văn A\" },\n    { \"fieldId\": 2, \"value\": 30 }\n  ]\n}" },
        "url": { "raw": "{{baseUrl}}/api/forms/:formId/submit", "host": ["{{baseUrl}}"], "path": ["api","forms",":formId","submit"], "variable": [{"key":"formId","value":"1"}] }
      }
    },
    {
      "name": "Get Submissions for Form",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/forms/:formId/submissions", "host": ["{{baseUrl}}"], "path": ["api","forms",":formId","submissions"], "variable": [{"key":"formId","value":"1"}] }
      }
    },
    {
      "name": "Get All Submissions (optional filter)",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/submissions?formId=1", "host": ["{{baseUrl}}"], "path": ["api","submissions"], "query": [{"key":"formId","value":"1"}] }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" }
  ]
}
